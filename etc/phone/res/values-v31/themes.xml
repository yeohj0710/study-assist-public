<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: black, static mark, no icon plate, no animation. -->
    <style name="Theme.StudyAssist" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/study_black</item>
        <item name="android:windowSplashScreenBackground">@color/study_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:colorBackground">@color/study_black</item>
        <item name="android:colorPrimary">@color/study_black</item>
        <item name="android:colorPrimaryDark">@color/study_black</item>
        <item name="android:colorAccent">@color/study_sage</item>
        <item name="android:textColorPrimary">@color/study_ink</item>
        <item name="android:textColorSecondary">@color/study_muted</item>
        <item name="android:statusBarColor">@color/study_black</item>
        <item name="android:navigationBarColor">@color/study_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.StudyAssist.Dialog</item>
    </style>
</resources>
